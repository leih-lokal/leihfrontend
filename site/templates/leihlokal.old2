<main>
  <header>
    <h1><?= $page->title() ?></h1>
  </header>
  <section class="children">
    <?php if ($page->children()->isNotEmpty()): ?>
      <ul>
        <?php foreach ($page->children() as $item): ?>
          <li>
            <a href="<?= $item->url() ?>">
              <?= $item->title() ?>
            </a>
          </li>
        <?php endforeach ?>
      </ul>
    <?php else: ?>
      <p>No items found.</p>
    <?php endif ?>
  </section>
</main>

